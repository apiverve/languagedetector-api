    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "languagedetector",
        "language detector api",
        "language detection api",
        "detect language api",
        "language recognition api",
        "free language detection api"
    ],
    "homepage": "https://apiverve.com/marketplace/languagedetector?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/languagedetector",
        "source": "https://github.com/apiverve/languagedetector-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Languagedetector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
